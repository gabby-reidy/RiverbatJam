  m_Script: {fileID: 11500000, guid: 4bcf67fa82e34b85b68a3f728b051054, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::BattleDialogue
  ball: {fileID: 1039872180}
  player: {fileID: 2068123657}
  enemy: {fileID: 1860210153}
  dialogueBox: {fileID: 6200000004}
  speakerLabel: {fileID: 6200000015}
  dialogueLabel: {fileID: 6200000019}
  continuePrompt: {fileID: 6200000020}
  defeatPanel: {fileID: 6300000000}
  restartLabel: {fileID: 6300000203}
  menuLabel: {fileID: 6300000303}
  nextScene: Cutscene2
  battleMusic: {fileID: 8300000, guid: 2e34548b922c44ff92b68aee14576dee, type: 3}
  introduction:
  - speaker: "INGRIUS"
    text: "Well well well. I can\u2019t say I\u2019m surprised to see you here, though I admit I am impressed. I didn\u2019t think your way of doing things would get you anywhere."
  - speaker: "BOB"
    text: "Question my methods all you like, you cannot deny that I, of my own power, stand here this day. I will prove to the world that it will be I, Bob the Great, who shall save it from the dragon."
  - speaker: "INGRIUS"
    text: "Bob, you know as well as I do the dragon cannot be defeated, not by just one wizard\u2019s strength. I admire your foolhardy courage, but if you wish to prove yourself to the world, you must first prove yourself to me."
  playerLostLifeQuips:
  - speaker: "INGRIUS"
    text: "Your confidence leaves you open, Bob."
  - speaker: "INGRIUS"
    text: "Think before you strike."
  enemyLostLifeQuips:
  - speaker: "INGRIUS"
    text: "Better. Show me that was no accident."
  - speaker: "INGRIUS"
    text: "So there is discipline beneath that pride."
  victory:
  - speaker: "INGRIUS"
    text: "Then perhaps... you can do what I could not. Go, Bob."
  defeat:
  - speaker: "INGRIUS"
    text: "Power without wisdom will carry you no further."
  lettersPerSecond: 45
  lineHold: 1.8
  openingServeMultiplier: 1.3
