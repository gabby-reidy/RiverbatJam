  m_Script: {fileID: 11500000, guid: 4bcf67fa82e34b85b68a3f728b051054, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BattleDialogue
  ball: {fileID: 1039872180}
  player: {fileID: 7800000001}
  enemy: {fileID: 7800000004}
  dialogueBox: {fileID: 6200000004}
  speakerLabel: {fileID: 6200000015}
  dialogueLabel: {fileID: 6200000019}
  continuePrompt: {fileID: 6200000020}
  defeatPanel: {fileID: 6300000000}
  restartLabel: {fileID: 6300000203}
  menuLabel: {fileID: 6300000303}
  nextScene: Cutscene3
  battleMusic: {fileID: 8300000, guid: f27f224652df49b5a373c267589d8cdd, type: 3}
  introduction:
  - speaker: GOBLIN KING
    text: "If it isn\u2019t Bob the Great. I hear you\u2019ve been going around,
      trying to undermine the dragon."
  - speaker: BOB
    text: "I will tolerate the dragon\u2019s tyranny no longer. If you wish to stand
      in my way, then you shall fall, just as the dragon will."
  - speaker: GOBLIN KING
    text: I will do my duty as a Guardian. You must defeat me if you wish to continue
      your doomed quest.
  playerLostLifeQuips:
  - speaker: GOBLIN KING
    text: A king does not surrender his ground.
  - speaker: GOBLIN KING
    text: Your pride is easier to break than my guard.
  enemyLostLifeQuips:
  - speaker: GOBLIN KING
    text: You will not take my crown so easily.
  - speaker: GOBLIN KING
    text: My guard bends. It does not bow.
  victory:
  - speaker: GOBLIN KING
    text: My watch... is ended. Face the dragon, if you dare.
  defeat:
  - speaker: GOBLIN KING
    text: Your quest ends at my gate, Bob.
  lettersPerSecond: 45
  lineHold: 1.8
  openingServeMultiplier: 1.3
